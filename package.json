{
  "name": "nox-wiki-codex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:public": "node --env-file-if-exists=.env --import vite-plus/register apps/server/src/main.ts public",
    "dev:admin": "node --env-file-if-exists=.env --import vite-plus/register apps/server/src/main.ts admin",
    "dev:ui": "node --env-file-if-exists=.env --run dev:ui:server",
    "build": "npm run build:server && npm run build:public && npm run build:admin",
    "build:server": "vp pack",
    "build:public": "vp build --mode public",
    "build:admin": "vp build --mode admin",
    "start": "node --env-file-if-exists=.env build/server/main.js public",
    "admin": "node --env-file-if-exists=.env build/server/main.js admin",
    "check": "vp check && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vpx --test --test-concurrency=1 test/*.test.ts",
    "release": "node scripts/release.mjs",
    "test:ci-policy": "node --test scripts/ci-policy.test.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('scripts/install-hooks.mjs')) await import('./scripts/install-hooks.mjs');\"",
    "precommit": "node scripts/git-hooks.mjs commit",
    "prepush": "node scripts/format-files.mjs --check --revision HEAD && npm run check",
    "test:release": "node --test scripts/release.test.mjs scripts/ci-policy.test.mjs",
    "check:code": "vp check",
    "format:check": "node scripts/format-files.mjs --check",
    "format": "node scripts/format-files.mjs",
    "dev:ui:server": "vp dev --config vite.config.ts --mode admin",
    "test:format": "node --test scripts/format-files.test.mjs",
    "precheck": "npm run format:check"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "htmlparser2": "^12.0.0",
    "i18next": "^25.0.0",
    "markdown-it": "^14.1.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "proper-lockfile": "^4.1.2",
    "svelte": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "3.4.2",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/express": "^5.0.0",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "phosphor-svelte": "^3.1.0",
    "prettier": "3.10.1",
    "prettier-plugin-sh": "0.20.2",
    "svelte-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  }
}
